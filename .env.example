# Copy this file to .env for local (non-Docker) development:
#   cp .env.example .env
#
# .env is gitignored and must never be committed. In Docker Compose these
# values come from docker-compose.yml; in production they come from AWS
# Secrets Manager (see AWS_SECRETS_MANAGER_SECRET_ID below), so the ECS task
# definition contains no credentials at all.

# ---- Application ----
APP_ENV=development
APP_PORT=8080
APP_VERSION=0.1.0-dev
APP_BUILD_TIME=local
APP_GIT_COMMIT=local

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=bridgecore
DB_PASSWORD=bridgecore
DB_NAME=bridgecore
# "disable" is fine locally; the app refuses to start in production with it.
DB_SSLMODE=disable
# MaxOpenConns * number of tasks must stay below the RDS max_connections limit.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ---- Redis / ElastiCache ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Set true for ElastiCache with in-transit encryption enabled.
REDIS_TLS=false

# ---- JWT ----
# Generate real secrets for anything beyond local dev:
#   openssl rand -base64 48
# The two must differ, so a refresh token can never be replayed as an access
# token. Production additionally requires at least 32 characters each.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=bridgecore

# ---- API keys ----
API_KEY_PREFIX=bc_live_

# ---- Platform control plane ----
# Authenticates the cross-tenant operator endpoints under /api/v1/platform.
# Deliberately separate from any customer credential: no tenant JWT, however
# privileged inside its own tenant, can reach a cross-tenant operation.
# Leave empty to not register those routes at all.
#   openssl rand -hex 32
PLATFORM_ADMIN_TOKEN=local-dev-platform-token-change-me-please

# ---- CORS ----
# A comma-separated allow-list. Wildcard is rejected in production.
CORS_ALLOWED_ORIGINS=*
CORS_MAX_AGE=10m

# ---- Rate limiting & pagination ----
RATE_LIMIT_RPM=120
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---- GraphQL ----
GRAPHQL_PATH=/graphql
# Ceilings applied before execution. See graph/complexity.go.
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=500
GRAPHQL_MAX_QUERY_BYTES=16384
# Both must be false in production; config validation enforces it.
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# ---- Swagger UI / dev tooling ----
EXPOSE_DEV_TOOLS=true

# ---- Usage exports ----
# local  = filesystem object store with HMAC-signed download URLs (default)
# s3     = private S3 bucket with SigV4 presigned URLs
EXPORT_BACKEND=local
EXPORT_LOCAL_DIR=./var/exports
EXPORT_S3_BUCKET=
EXPORT_S3_PREFIX=usage-exports
EXPORT_DOWNLOAD_TTL=15m
# Defaults to JWT_ACCESS_SECRET when empty.
EXPORT_SIGNING_KEY=
# Run the worker inside the API process. In production set this to false and
# run cmd/worker as its own ECS service, or use the SQS + Lambda consumer.
EXPORT_IN_PROCESS_WORKER=true
EXPORT_WORKER_POLL_INTERVAL=2s
EXPORT_WORKER_BATCH_SIZE=5
EXPORT_MAX_ROWS=500000
EXPORT_MAX_ATTEMPTS=3
# When set, export jobs are also published to SQS so a Lambda consumer can
# process them immediately instead of waiting for the worker's next poll.
EXPORT_SQS_QUEUE_URL=

# ---- AWS ----
AWS_REGION=ap-south-1
# Leave empty on ECS: credentials come from the task role and rotate
# automatically. These exist only for MinIO/LocalStack testing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_ENDPOINT=
# ARN or name of a Secrets Manager secret holding a flat JSON object of
# KEY: value pairs. Loaded before the environment is read, so production
# secrets never appear in the task definition.
AWS_SECRETS_MANAGER_SECRET_ID=
