# Copy this file to .env for local (non-Docker) development.
# In Docker Compose, these are set directly in docker-compose.yml —
# this file is for `go run ./cmd/api` on your host machine.

# ---- Application ----
APP_ENV=development
APP_PORT=8080
APP_VERSION=0.1.0-dev
APP_BUILD_TIME=local

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=bridgecore
DB_PASSWORD=bridgecore
DB_NAME=bridgecore
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
# IMPORTANT: generate strong, random secrets for anything beyond local dev.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=bridgecore

# ---- API Keys ----
API_KEY_PREFIX=bc_live_

# ---- Rate limiting ----
RATE_LIMIT_RPM=120
