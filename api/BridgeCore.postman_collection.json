{
  "info": {
    "name": "BridgeCore API",
    "description": "Full request collection for the BridgeCore platform API. Import into Postman, set the `base_url` and run Signup/Login first to populate `access_token`/`refresh_token` collection variables automatically via the request's test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "tenant_id", "value": "" },
    { "key": "api_key", "value": "" },
    { "key": "api_key_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{base_url}}/health" } },
        { "name": "Ready", "request": { "method": "GET", "url": "{{base_url}}/ready" } },
        { "name": "Live", "request": { "method": "GET", "url": "{{base_url}}/live" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('access_token', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.data.tokens.refresh_token);",
                  "  pm.collectionVariables.set('tenant_id', body.data.tenant.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_name\": \"Acme Corp\",\n  \"email\": \"founder@acme.test\",\n  \"password\": \"SuperSecret123!\",\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('access_token', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.data.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bridgecore.dev\",\n  \"password\": \"AdminPass123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Create Tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Co\",\n  \"slug\": \"new-co\",\n  \"plan\": \"free\"\n}" }
          }
        },
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/tenants?page=1&page_size=20"
          }
        },
        {
          "name": "Get Tenant",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/tenants/{{tenant_id}}"
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"pro\"\n}" }
          }
        },
        {
          "name": "Delete Tenant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/tenants/{{tenant_id}}"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/users"
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/users/:id/role",
            "variable": [{ "key": "id", "value": "" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"developer\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Entitlements",
      "item": [
        {
          "name": "List Feature Catalog",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/features"
          }
        },
        {
          "name": "List My Tenant's Features",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/features/mine"
          }
        },
        {
          "name": "Grant Feature",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/features/grant",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"feature_key\": \"usage.export\",\n  \"enabled\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Generate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('api_key', body.data.api_key);",
                  "  pm.collectionVariables.set('api_key_id', body.data.details.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/v1/apikeys",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"ci-key\"\n}" }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/apikeys"
          }
        },
        {
          "name": "Rotate API Key",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/apikeys/{{api_key_id}}/rotate"
          }
        },
        {
          "name": "Deactivate API Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/apikeys/{{api_key_id}}"
          }
        },
        {
          "name": "Authenticated Request via API Key",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": "{{base_url}}/api/v1/usage/summary"
          }
        }
      ]
    },
    {
      "name": "Usage",
      "item": [
        {
          "name": "List Usage",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/usage?page=1&page_size=20"
          }
        },
        {
          "name": "Usage Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/usage/summary"
          }
        },
        {
          "name": "Usage Export (CSV, requires Pro/Enterprise)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/usage/export"
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/audit?page=1&page_size=20"
          }
        },
        {
          "name": "Get Audit Log Entry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/audit/:id",
            "variable": [{ "key": "id", "value": "" }]
          }
        }
      ]
    }
  ]
}
