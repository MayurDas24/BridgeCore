{
  "info": {
    "name": "BridgeCore API",
    "description": "Full request collection for the BridgeCore platform API. Import into Postman, set the `base_url` and run Signup/Login first to populate `access_token`/`refresh_token` collection variables automatically via the request's test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "tenant_id",
      "value": ""
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "api_key_id",
      "value": ""
    },
    {
      "key": "platform_token",
      "value": "local-dev-platform-token-change-me-please"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "export_job_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ready"
          }
        },
        {
          "name": "Live",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/live"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('access_token', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.data.tokens.refresh_token);",
                  "  pm.collectionVariables.set('tenant_id', body.data.tenant.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_name\": \"Acme Corp\",\n  \"email\": \"founder@acme.test\",\n  \"password\": \"SuperSecret123!\",\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Lovelace\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('access_token', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.data.tokens.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bridgecore.dev\",\n  \"password\": \"AdminPass123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Get My Tenant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenant",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenant"
              ]
            },
            "description": "Returns the authenticated caller's tenant."
          }
        },
        {
          "name": "Update My Tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenant",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenant"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corporation\"\n}"
            },
            "description": "Only the display name is mutable. There is no plan field: a tenant's plan determines its feature entitlements, so a writable plan would let a tenant grant itself any feature. Requires the admin role."
          }
        },
        {
          "name": "List Tenants (own only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            },
            "description": "Always returns exactly one tenant \u2014 the caller's own."
          }
        },
        {
          "name": "Get Tenant by ID (own only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants",
                "{{tenant_id}}"
              ]
            },
            "description": "Substitute another tenant's id here and the response is 404, not 403."
          }
        }
      ],
      "description": "Tenant-scoped endpoints. The caller can only ever reach its own tenant; any other id returns 404 rather than 403, so this API cannot be used to discover which tenant ids exist. Cross-tenant management lives in the Platform folder behind a separate operator credential."
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=1&page_size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Users in the caller's tenant only. page_size is clamped to the configured maximum rather than rejected, so an oversized request returns the ceiling plus a meta block indicating more pages."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.items && d.items.length) {",
                  "  pm.collectionVariables.set(\"user_id\", d.items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "Returns 400 for API-key credentials, which authenticate a tenant rather than a person."
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "A user id from another tenant returns 404."
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}/role",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{user_id}}",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"developer\"\n}"
            },
            "description": "Admin only. A caller cannot change their own role, and the last remaining admin of a tenant cannot be demoted."
          }
        },
        {
          "name": "Set User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{user_id}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "description": "Admin only. The last remaining admin cannot be deactivated."
          }
        }
      ]
    },
    {
      "name": "Entitlements",
      "item": [
        {
          "name": "List Feature Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/features"
          }
        },
        {
          "name": "List My Tenant's Features",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/features/mine"
          }
        }
      ],
      "description": "Read-only for tenants. Granting is a platform operation \u2014 see the Platform folder."
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Generate API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data) {",
                  "  pm.collectionVariables.set('api_key', body.data.api_key);",
                  "  pm.collectionVariables.set('api_key_id', body.data.details.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/apikeys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ci-key\"\n}"
            }
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/apikeys"
          }
        },
        {
          "name": "Rotate API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/apikeys/{{api_key_id}}/rotate"
          }
        },
        {
          "name": "Deactivate API Key",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/apikeys/{{api_key_id}}"
          }
        },
        {
          "name": "Authenticated Request via API Key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/usage/summary"
          }
        }
      ]
    },
    {
      "name": "Usage",
      "item": [
        {
          "name": "List Usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/usage?page=1&page_size=20"
          }
        },
        {
          "name": "Usage Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/usage/summary"
          }
        },
        {
          "name": "Request Usage Export",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/usage/exports",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "usage",
                "exports"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"2026-08-01T00:00:00Z\"\n}"
            },
            "description": "Requires the \"usage.export\" entitlement (Pro/Enterprise). Returns 202 with a job to poll. A free-plan tenant gets 403 with code FEATURE_NOT_ENTITLED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.job) { pm.collectionVariables.set(\"export_job_id\", d.job.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List Export Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/usage/exports",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "usage",
                "exports"
              ]
            }
          }
        },
        {
          "name": "Get Export Job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/usage/exports/{{export_job_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "usage",
                "exports",
                "{{export_job_id}}"
              ]
            },
            "description": "Includes a freshly minted download URL once the job is complete."
          }
        },
        {
          "name": "Get Export Download URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/usage/exports/{{export_job_id}}/download",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "usage",
                "exports",
                "{{export_job_id}}",
                "download"
              ]
            },
            "description": "The URL is generated per request and never stored, so it always expires and a replayed old response is not a usable capability."
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/audit?page=1&page_size=20"
          }
        },
        {
          "name": "Get Audit Log Entry",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/audit/:id",
            "variable": [
              {
                "key": "id",
                "value": ""
              }
            ]
          }
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "Dashboard Query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query Dashboard {\\n  me { id email role }\\n  tenant { id name plan isActive }\\n  myFeatures\\n  usageSummary { endpoint method requestCount errorCount avgLatencyMs }\\n}\"\n}"
            },
            "description": "Several REST endpoints' worth of data in one round trip."
          }
        },
        {
          "name": "Users with Nested Tenant (DataLoader)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query {\\n  users(pageSize: 20) {\\n    nodes { id email role isActive tenant { id name plan } }\\n    pageInfo { page pageSize totalCount totalPages hasNext }\\n  }\\n}\"\n}"
            },
            "description": "The nested tenant field is batch-loaded: one query for the whole page rather than one per user."
          }
        },
        {
          "name": "Cross-Tenant Lookup Returns Null",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query ($id: ID!) {\\n  user(id: $id) { id email }\\n}\",\n  \"variables\": {\n    \"id\": \"00000000-0000-0000-0000-000000000000\"\n  }\n}"
            },
            "description": "An id belonging to another tenant resolves to null, matching the REST 404."
          }
        },
        {
          "name": "Update Tenant (mutation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation {\\n  updateTenant(input: { name: \\\"Acme Corporation\\\" }) { id name plan }\\n}\"\n}"
            },
            "description": "Requires the admin role. UpdateTenantInput has no plan field."
          }
        },
        {
          "name": "Generate API Key (mutation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation {\\n  generateApiKey(input: { name: \\\"ci-pipeline\\\" }) {\\n    apiKey { id prefix lastFour createdAt }\\n    plaintext\\n  }\\n}\"\n}"
            },
            "description": "The plaintext is returned once and is not recoverable afterwards."
          }
        },
        {
          "name": "Request Export (entitlement-gated mutation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": [
                "{{base_url}}"
              ],
              "path": [
